# Modèle de configuration. Copie ce fichier en ".env" et mets tes propres valeurs.
#   cp .env.example .env
# Le fichier .env réel n'est JAMAIS versionné (il contient des secrets).

# Identifiants du compte administrateur créé au premier démarrage.
ADMIN_EMAIL=admin@notevault.local
ADMIN_PASSWORD=change-moi
